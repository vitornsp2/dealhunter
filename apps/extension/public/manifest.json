{
  "manifest_version": 3,
  "name": "DealHunter",
  "description": "A privacy-conscious foundation for organizing product searches.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8787/*"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "DealHunter",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
